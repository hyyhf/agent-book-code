# AI 模型配置（OpenAI-compatible）
# 默认示例使用 DeepSeek；也可以替换为任何兼容 OpenAI API 格式的服务商。
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_API_KEY=your_model_api_key_here
OPENAI_MODEL_NAME=deepseek-v4-pro

# AI 模型配置 - Qwen 示例
# OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# OPENAI_API_KEY=your_qwen_api_key_here
# OPENAI_MODEL_NAME=qwen-plus-2025-12-01

# AI 模型配置 - Kimi 示例
# OPENAI_BASE_URL=https://api.moonshot.cn/v1
# OPENAI_API_KEY=your_kimi_api_key_here
# OPENAI_MODEL_NAME=kimi-k2.5

# OpenAI Tracing API Key（可选）
# Chapter 12 或需要 OpenAI tracing 时再填写。
OPENAI_TRACING_API_KEY=your_openai_tracing_api_key_here

# Tavily API Key（可选）
# FunHarness 的 web_search 工具需要该配置；不使用网页搜索可以留空。
TAVILY_API_KEY=your_tavily_api_key_here

# 飞书机器人配置（可选）
# 仅在运行 `uv run fh feishu` 或 `uv run fh-feishu` 时需要。
FEISHU_APP_ID=cli_your_app_id_here
FEISHU_APP_SECRET=your_feishu_app_secret_here
FEISHU_EVENT_MODE=ws
FEISHU_PERMISSION_MODE=suggest
FEISHU_WORKSPACE=defaultspace

# 飞书 HTTP callback 模式（可选）
# 默认推荐使用 ws 长连接模式，不需要公网地址。
# 只有在你明确设置 FEISHU_EVENT_MODE=http 时才需要下面这些配置。
# FEISHU_VERIFICATION_TOKEN=your_feishu_verification_token_here
# FEISHU_HOST=0.0.0.0
# FEISHU_PORT=8787
# FEISHU_CALLBACK_PATH=/feishu/events
# FEISHU_API_BASE=https://open.feishu.cn/open-apis
